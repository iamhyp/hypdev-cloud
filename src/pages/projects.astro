---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title="Projects, Lawal Alabe"
	description="Security engineering projects covering infrastructure as code, cloud security architecture, and Kubernetes platform hardening."
>
	<div class="page">
		<header class="page-head">
			<h1 class="page-title">Projects</h1>
		</header>

		{/*
		  An empty state that is meant to be empty. It says why there is
		  nothing here and what would put something here, rather than
		  apologising or promising a date.
		*/}
		<p class="empty">Projects appear here when fully built, documented, and pushed to GitHub.</p>
	</div>
</BaseLayout>

<style>
	.empty {
		max-width: 620px;
		margin: 0;
		padding: 40px 0 0;
		border-top: 1px solid var(--border-faint);
		font-size: 17px;
		line-height: 1.75;
		text-wrap: pretty;
		color: var(--muted);
	}
</style>
