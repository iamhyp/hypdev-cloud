---
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';
import siteConfig from '../config/site';
import { skillGroups } from '../config/skills';

const subtitleItems = ['Infrastructure as Code', 'Kubernetes', 'Cloud Security', 'Applied AI'];

const pillars = [
	{
		color: 'red',
		name: 'Perimeter',
		description:
			'WAF, network firewall, zero trust access. Threats are rejected before they reach compute.',
		note: 'blast radius first',
	},
	{
		color: 'amber',
		name: 'Identity',
		description:
			'Least-privilege IAM, IRSA, RBAC. Overly broad roles are the most common breach vector.',
		note: 'least privilege',
	},
	{
		color: 'cyan',
		name: 'Data protection',
		description: 'KMS, Secrets Manager, Vault. Key management is where real security judgment lives.',
		note: 'encryption at rest',
	},
	{
		color: 'green',
		name: 'Detection',
		description:
			'GuardDuty, Falco, CloudTrail, Security Hub. Prevention always fails. Detection speed is the metric.',
		note: 'MITRE ATT&CK mapped',
	},
];

function loadIcon(name: string) {
	return fs.readFileSync(path.join(process.cwd(), 'public/icons', `${name}.svg`), 'utf-8');
}

/*
 * The shell's command set. Every command's output is rendered into the
 * page as markup and cloned by /scripts/terminal.js at runtime, so the
 * script holds no copy of the content: the command list, tab completion
 * and `help` are all derived from what is actually in the DOM. Adding a
 * command here adds it everywhere, and nothing can drift out of sync.
 */
type CliLine = {
	key?: string;
	text?: string;
	href?: string;
	external?: boolean;
	tone?: 'muted' | 'accent';
};

type CliCommand = { name: string; summary: string; lines: CliLine[] };

const commands: CliCommand[] = [
	{
		name: 'pipeline',
		summary: 'how a change reaches production',
		lines: [
			{ key: 'plan', text: 'Reviewed before anything is applied. Nothing is changed by hand in a console.' },
			{ key: 'sign', text: 'An image without verifiable provenance does not reach the cluster.' },
			{ key: 'scan', text: 'Gated on CRITICAL. Zero is the only number that passes.' },
			{ key: 'enforce', text: 'The cluster proves the policy holds. I do not assume that it does.' },
		],
	},
	{
		name: 'whoami',
		summary: 'who I am and what I do',
		lines: [
			{ text: siteConfig.author.name, tone: 'accent' },
			{ text: siteConfig.author.role },
			{ text: `${siteConfig.author.location} · available remote`, tone: 'muted' },
			{ text: '' },
			{ text: 'I build secure platforms and harden cloud-native infrastructure at scale.' },
		],
	},
	{
		name: 'stack',
		summary: 'the full technical skills list',
		// Flattened from src/config/skills.ts, the same source the CV
		// page reads, so the shell cannot claim a tool the CV does not.
		lines: skillGroups.flatMap((group, i): CliLine[] => [
			...(i > 0 ? [{ text: '' }] : []),
			{ text: group.heading, tone: 'accent' as const },
			...group.rows.map((row) => ({ key: row.key, text: row.value })),
		]),
	},
	{
		name: 'certs',
		summary: 'credentials, each verifiable',
		lines: [
			{ text: `${siteConfig.certifications.length} credentials, each verifiable on Credly:`, tone: 'muted' },
			...siteConfig.certifications.map((cert) => ({
				key: '·',
				text: cert.name,
				href: cert.credlyUrl,
				external: true,
			})),
		],
	},
	{
		name: 'contact',
		summary: 'how to reach me',
		lines: [
			{ key: 'email', text: siteConfig.social.email, href: `mailto:${siteConfig.social.email}` },
			{
				key: 'linkedin',
				text: siteConfig.social.linkedin.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, ''),
				href: siteConfig.social.linkedin,
				external: true,
			},
			{
				key: 'github',
				text: siteConfig.social.github.replace(/^https?:\/\/(www\.)?/, ''),
				href: siteConfig.social.github,
				external: true,
			},
		],
	},
	{
		name: 'cv',
		summary: 'download the CV',
		lines: [{ key: '→', text: 'Open the CV page', href: '/cv/' }],
	},
];

const bootCommand = commands[0];

const stats = [
	{ value: '5', suffix: '+', label: 'Certifications' },
	{ value: '3', suffix: '+', label: 'Peer-reviewed publications' },
	{ value: '2', suffix: '', label: "Funded master's degrees" },
];

const techColumns = [
	{
		heading: 'CLOUD & INFRA',
		tools: [
			{ name: 'AWS', icon: loadIcon('aws'), slug: 'aws' },
			{ name: 'Azure', icon: loadIcon('azure'), slug: 'azure' },
			{ name: 'Terraform', icon: loadIcon('terraform'), slug: 'terraform' },
			{ name: 'Kubernetes', icon: loadIcon('kubernetes'), slug: 'kubernetes' },
			{ name: 'Docker', icon: loadIcon('docker'), slug: 'docker' },
		],
	},
	{
		heading: 'CI/CD & AUTOMATION',
		tools: [
			{ name: 'Jenkins', icon: loadIcon('jenkins'), slug: 'jenkins' },
			{ name: 'GitHub Actions', icon: loadIcon('github'), slug: 'github' },
			{ name: 'ArgoCD', icon: loadIcon('argocd'), slug: 'argocd' },
			{ name: 'Ansible', icon: loadIcon('ansible'), slug: 'ansible' },
		],
	},
	{
		heading: 'LANGUAGES & DEV',
		tools: [
			{ name: 'Python', icon: loadIcon('python'), slug: 'python' },
			{ name: 'C++', icon: loadIcon('cplusplus'), slug: 'cplusplus' },
			{ name: 'Bash', icon: loadIcon('bash'), slug: 'bash' },
			{ name: 'PowerShell', icon: loadIcon('powershell'), slug: 'powershell' },
		],
	},
];
---

<BaseLayout title={siteConfig.site.title} description={siteConfig.site.description}>
	<section class="hero">
		<div class="hero-glow" aria-hidden="true"></div>
		<div class="hero-grid" aria-hidden="true"></div>

		<div class="hero-content">
			<h1 class="hero-name"
				><span class="hero-name-text">Lawal</span><span class="hero-name-dot">.</span></h1
			>

			<p class="hero-role">{siteConfig.author.role}</p>

			<p class="hero-subtitle">
				{
					subtitleItems.map((item, i) => (
						<span class="hero-subtitle-unit">
							<span class="hero-subtitle-item">{item}</span>
							{i < subtitleItems.length - 1 && <span class="hero-subtitle-pipe">|</span>}
						</span>
					))
				}
			</p>

			<p class="hero-location">Australia · Remote</p>

			<p class="hero-paragraph">
				I build secure platforms and harden cloud-native infrastructure at scale. My work sits
				across infrastructure as code, Kubernetes security, and applied AI workload protection. I
				bring depth from AWS, research from two funded master's degrees, and hands-on work from
				production environments.
			</p>

			<div class="hero-actions">
				<div class="hero-buttons">
					<a href="/projects/" class="btn-primary">View projects</a>
					<a href="/about/" class="btn-outline">About me</a>
				</div>
				<div class="hero-social">
					<a
						href={siteConfig.social.github}
						target="_blank"
						rel="noopener noreferrer"
						class="hero-link">GitHub<span class="hero-link-arrow" aria-hidden="true">↗</span></a
					>
					<a
						href={siteConfig.social.linkedin}
						target="_blank"
						rel="noopener noreferrer"
						class="hero-link">LinkedIn<span class="hero-link-arrow" aria-hidden="true">↗</span></a
					>
				</div>
			</div>

			<div class="hero-stats">
				{
					stats.map((stat) => (
						<div class="stat">
							<p class="stat-value">
								{stat.value}
								<span class="stat-plus">{stat.suffix}</span>
							</p>
							<p class="stat-label">{stat.label}</p>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<section class="terminal-section">
		<div class="section-head" data-reveal>
			<h2 class="section-title">How a change reaches production</h2>
			<p class="section-subtitle">
				Plan it, sign it, scan it, then prove the cluster agrees. Nothing ships unverified.
			</p>
		</div>

		<div class="terminal-layout" data-reveal>
			<div class="terminal" id="cli">
				<div class="terminal-titlebar">
					<span class="terminal-dot terminal-dot-red"></span>
					<span class="terminal-dot terminal-dot-amber"></span>
					<span class="terminal-dot terminal-dot-green"></span>
					<span class="terminal-title">lawal@hypdev zsh</span>
				</div>

				<div class="terminal-body">
					{/*
					  The boot output is rendered on the server, not typed in
					  by script. Without JavaScript this is a static terminal
					  showing exactly what the section heading promises, and
					  the prompt below it is simply disabled. Nothing about
					  the page's content depends on the shell running.
					*/}
					<div class="cli-output" id="cli-output" role="log" aria-live="polite">
						<p class="cli-echo">
							<span class="cli-prompt">lawal@hypdev:~$</span>
							<span class="cli-echo-cmd">{bootCommand.name}</span>
						</p>
						{
							bootCommand.lines.map((line) => (
								<p class="cli-line">
									{line.key && <span class="cli-key">{line.key}</span>}
									<span class="cli-text">{line.text}</span>
								</p>
							))
						}
					</div>

					<form class="cli-form" id="cli-form" autocomplete="off">
						<label class="cli-label" for="cli-input">Type a command, then press Enter</label>
						<span class="cli-prompt" aria-hidden="true">lawal@hypdev:~$</span>
						<span class="cli-cursor" aria-hidden="true"></span>
						<input
							class="cli-input"
							id="cli-input"
							name="command"
							type="text"
							disabled
							autocomplete="off"
							autocorrect="off"
							autocapitalize="off"
							spellcheck="false"
							aria-describedby="cli-hint"
						/>
					</form>
					<p class="cli-hint" id="cli-hint">Tab completes, Up and Down recall history.</p>
				</div>
			</div>

			<div class="cli-menu">
				<h3 class="cli-menu-heading">Commands</h3>
				<ul class="cli-menu-list">
					{
						commands.map((command) => (
							<li>
								<button type="button" class="cli-chip" data-cli-run={command.name}>
									<span class="cli-chip-name">{command.name}</span>
									<span class="cli-chip-summary">{command.summary}</span>
								</button>
							</li>
						))
					}
				</ul>
			</div>
		</div>

		{/*
		  Prototype rows for the script to clone.

		  Astro scopes component CSS with a generated attribute, which
		  elements built by document.createElement never carry — so a
		  script that constructs its own markup gets none of the styling
		  around it. Cloning server-rendered prototypes keeps every line
		  the shell prints inside the same scope as the ones this file
		  rendered, with no duplicated selectors and no global escape
		  hatch.
		*/}
		<div class="cli-proto" hidden aria-hidden="true">
			<p class="cli-echo" data-proto="echo">
				<span class="cli-prompt"></span><span class="cli-echo-cmd"></span>
			</p>
			<p class="cli-line" data-proto="line"><span class="cli-text"></span></p>
			<p class="cli-line" data-proto="keyed">
				<span class="cli-key"></span><span class="cli-text"></span>
			</p>
		</div>

		{/*
		  One hidden block per command. The script builds its registry from
		  these, so it never holds a copy of the copy.
		*/}
		{
			commands.map((command) => (
				<div class="cli-source" hidden data-cli-command={command.name} data-cli-summary={command.summary}>
					{command.lines.map((line) => (
						<p class={`cli-line${line.tone ? ' cli-line-' + line.tone : ''}`}>
							{line.key && <span class="cli-key">{line.key}</span>}
							{line.href ? (
								<a
									class="cli-link"
									href={line.href}
									target={line.external ? '_blank' : undefined}
									rel={line.external ? 'noopener noreferrer' : undefined}
								>
									{line.text}
								</a>
							) : (
								<span class="cli-text">{line.text}</span>
							)}
						</p>
					))}
				</div>
			))
		}
	</section>

	<section class="pillars-section">
		<div class="section-head" data-reveal>
			<h2 class="section-title">How I think about security</h2>
			<p class="section-subtitle">
				Four layers, in the order I reason about them on every platform I build.
			</p>
		</div>

		<div class="pillars-grid" data-reveal>
			{
				pillars.map((pillar) => (
					<div class="pillar">
						<div class="pillar-heading">
							<span class={`pillar-dot pillar-dot-${pillar.color}`} />
							<h3 class="pillar-name">{pillar.name}</h3>
						</div>
						<p class="pillar-description">{pillar.description}</p>
						<span class="pillar-note">{pillar.note}</span>
					</div>
				))
			}
		</div>
	</section>

	<section class="tech-section">
		<div class="section-head" data-reveal>
			<h2 class="section-title">Tech stack</h2>
			<p class="section-subtitle">Tools and platforms I run in production.</p>
		</div>

		<div class="tech-columns" data-reveal>
			{
				techColumns.map((column) => (
					<div class="tech-column">
						<h3 class="tech-column-heading">{column.heading}</h3>
						<div class="tech-tiles">
							{column.tools.map((tool) => (
								<div class="tech-tile">
									<span
										class="tile-icon"
										data-tool={tool.slug}
										aria-hidden="true"
										set:html={tool.icon}
									/>
									<span class="tile-name">{tool.name}</span>
								</div>
							))}
						</div>
					</div>
				))
			}
		</div>

		<div class="live" data-live hidden>
			<p class="live-label">
				<span class="live-dot" aria-hidden="true"></span>
				Live from the GitHub API
			</p>
			<dl class="live-figures">
				<div class="live-figure">
					<dd class="live-value" data-live-repos></dd>
					<dt class="live-name">Public repositories</dt>
				</div>
				<div class="live-figure">
					<dd class="live-value" data-live-stars></dd>
					<dt class="live-name">Stars earned</dt>
				</div>
				<div class="live-figure">
					<dd class="live-value live-value-text" data-live-pushed></dd>
					<dt class="live-name">Last push</dt>
				</div>
			</dl>
		</div>
	</section>

</BaseLayout>

<script is:inline src="/scripts/terminal.js"></script>
<script is:inline src="/scripts/reveal.js"></script>
<script is:inline src="/scripts/github.js"></script>

<style>
	.hero {
		position: relative;
		isolation: isolate;
		max-width: 1120px;
		margin: 0 auto;
		padding: 88px 24px 112px;
		overflow: hidden;
	}

	/*
	 * Barely-perceptible perspective grid, hero only. Static -- no
	 * animation, no parallax. Grid lines use the border token, never the
	 * accent colour, so this reads as ambient texture rather than a
	 * feature. The mask fades it to nothing well before the paragraph so
	 * no body text ever sits on top of a line.
	 */
	.hero-grid {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		top: -90px;
		left: -20%;
		right: -20%;
		height: 780px;
		pointer-events: none;
		background-image:
			repeating-linear-gradient(to right, var(--grid-line) 0 1px, transparent 1px 58px),
			repeating-linear-gradient(to bottom, var(--grid-line) 0 1px, transparent 1px 58px);
		transform: perspective(900px) rotateX(60deg);
		transform-origin: top center;
		opacity: 1;
		mask-image: linear-gradient(to bottom, black 4%, rgba(0, 0, 0, 0.55) 38%, transparent 76%);
		-webkit-mask-image: linear-gradient(
			to bottom,
			black 4%,
			rgba(0, 0, 0, 0.55) 38%,
			transparent 76%
		);
	}

	/*
	 * A second, wider wash sits under the grid so the top of the page has
	 * depth instead of reading as a flat black slab. Kept to the hero.
	 */
	.hero-glow {
		position: absolute;
		top: -240px;
		left: 50%;
		width: 1100px;
		height: 620px;
		margin-left: -550px;
		pointer-events: none;
		background: radial-gradient(
			50% 50% at 50% 50%,
			var(--hero-glow) 0%,
			transparent 70%
		);
	}

	.hero-content {
		position: relative;
		z-index: 1;
	}

	/*
	 * Staggered entrance on the hero, CSS only — no script, so nothing
	 * to add to the CSP hash. `both` fill matters: the global
	 * reduced-motion rule collapses the duration to 0.01ms rather than
	 * removing the animation, so the fill is what guarantees the end
	 * state sticks and the text is never left invisible. The explicit
	 * reduce block below is the belt to that braces.
	 */
	@keyframes hero-rise {
		from {
			opacity: 0;
			transform: translateY(14px);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}

	.hero-content > * {
		animation: hero-rise 0.62s cubic-bezier(0.22, 0.61, 0.36, 1) both;
	}

	.hero-content > *:nth-child(2) {
		animation-delay: 0.06s;
	}

	.hero-content > *:nth-child(3) {
		animation-delay: 0.1s;
	}

	.hero-content > *:nth-child(4) {
		animation-delay: 0.13s;
	}

	.hero-content > *:nth-child(5) {
		animation-delay: 0.17s;
	}

	.hero-content > *:nth-child(6) {
		animation-delay: 0.22s;
	}

	.hero-content > *:nth-child(7) {
		animation-delay: 0.28s;
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-content > * {
			animation: none;
			opacity: 1;
			transform: none;
		}
	}

	.hero-location {
		margin: 14px 0 0;
		font-family: var(--font-mono);
		font-size: 13.5px;
		font-weight: 500;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.hero-name {
		margin: 0 0 0 -0.055em;
		font-family: var(--font-mono);
		font-weight: 700;
		font-size: clamp(3.5rem, 7.2vw, 5.5rem);
		line-height: 1.02;
		letter-spacing: -0.035em;
	}

	.hero-name-text {
		color: var(--text);
	}

	/*
	 * Monospace centres the full stop in a full character cell, which
	 * reads as a space between the name and the dot. This pulls it back
	 * to sit the way it would in proportional type. -0.12em, not more:
	 * a larger pull closes the gap entirely and the dot collides with
	 * the l. The same value is used in the social card so the two match.
	 */
	.hero-name-dot {
		margin-left: -0.12em;
		color: var(--cyan);
	}

	.hero-role {
		margin: 22px 0 0;
		font-family: var(--font-mono);
		font-size: clamp(21px, 2.6vw, 33px);
		font-weight: 500;
		text-wrap: balance;
		letter-spacing: -0.025em;
		color: var(--muted);
	}

	.hero-subtitle {
		margin: 20px 0 0;
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		font-family: var(--font-mono);
		font-size: 15px;
	}

	.hero-subtitle-unit {
		display: inline-flex;
		gap: 10px;
	}

	.hero-subtitle-item {
		color: var(--muted);
	}

	.hero-subtitle-pipe {
		color: var(--faint);
	}

	.hero-paragraph {
		margin: 34px 0 0;
		max-width: 720px;
		font-size: 17px;
		line-height: 1.78;
		text-wrap: pretty;
		letter-spacing: -0.01em;
		color: var(--muted);
	}

	.hero-actions {
		margin-top: 40px;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 16px 24px;
	}

	.hero-buttons {
		display: flex;
		gap: 14px;
	}

	.hero-social {
		display: flex;
		align-items: center;
		gap: 24px;
		padding-left: 24px;
		border-left: 1px solid var(--border-faint);
	}

	/*
	 * GitHub and LinkedIn are a third tier, below the two buttons. They
	 * were sitting flush against the About me button, which read as two
	 * buttons that had lost their styling. A rule and extra lead-in make
	 * the demotion look chosen.
	 */
	.hero-link {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-size: 16px;
		font-weight: 500;
		color: var(--muted);
		text-decoration: none;
		transition: color 0.15s ease;
	}

	.hero-link-arrow {
		font-size: 12px;
		color: var(--faint);
		transition: transform 0.15s ease;
	}

	.hero-link:hover {
		color: var(--text);
	}

	.hero-link:hover .hero-link-arrow {
		color: var(--cyan);
		transform: translate(1px, -1px);
	}

	/*
	 * Credentials belong with the introduction, not stranded at the
	 * bottom of the page. A hairline above them separates them from the
	 * actions without adding another box.
	 */
	.hero-stats {
		display: flex;
		max-width: 720px;
		margin-top: 56px;
		padding-top: 30px;
		border-top: 1px solid var(--border-faint);
	}

	.stat {
		flex: 1;
		min-width: 0;
		padding: 0 26px;
	}

	.stat:first-child {
		padding-left: 0;
	}

	.stat:not(:first-child) {
		border-left: 1px solid var(--border-faint);
	}

	.stat-value {
		margin: 0 0 6px;
		font-family: var(--font-mono);
		font-size: 36px;
		font-weight: 700;
		letter-spacing: -0.035em;
		font-variant-numeric: tabular-nums;
		color: var(--text);
	}

	.stat-plus {
		font-size: 26px;
		color: var(--cyan);
	}

	/*
	 * Narrowing the row to the paragraph's measure means the longest
	 * label wraps below about 1100px. Balancing the break keeps the two
	 * lines even instead of leaving one word stranded.
	 */
	.stat-label {
		margin: 0;
		font-size: 14px;
		line-height: 1.45;
		text-wrap: balance;
		color: var(--muted);
	}

	@media (max-width: 640px) {
