---
import BaseLayout from '../layouts/BaseLayout.astro';
import siteConfig from '../config/site';

const links = [
	{
		label: 'LinkedIn',
		value: siteConfig.social.linkedin.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, ''),
		href: siteConfig.social.linkedin,
		external: true,
	},
	{
		label: 'GitHub',
		value: siteConfig.social.github.replace(/^https?:\/\/(www\.)?/, ''),
		href: siteConfig.social.github,
		external: true,
	},
	{
		label: 'Email',
		value: siteConfig.social.email,
		href: `mailto:${siteConfig.social.email}`,
		external: false,
	},
];
---

<BaseLayout
	title="Contact, Lawal Alabe"
	description="Get in touch with Lawal Alabe, Platform Security Engineer based in Sydney, Australia."
>
	<div class="page">
		<header class="page-head">
			<h1 class="page-title">Contact</h1>
			<p class="page-intro">The best ways to reach me.</p>
		</header>

		<ul class="links">
			{
				links.map((link) => (
					<li class="link-row">
						<span class="link-label">{link.label}</span>
						<a
							class="link-value"
							href={link.href}
							target={link.external ? '_blank' : undefined}
							rel={link.external ? 'noopener noreferrer' : undefined}
						>
							{link.value}
							{link.external && (
								<span class="link-arrow" aria-hidden="true">
									↗
								</span>
							)}
						</a>
					</li>
				))
			}
		</ul>

		<section class="cv-section">
			<h2 class="section-title cv-heading">Curriculum vitae</h2>
			<p class="cv-line">Read my CV online or download a PDF copy</p>
			<div class="button-row">
				<a href="/cv/" class="btn-primary">View CV</a>
				<a href={siteConfig.cv} target="_blank" rel="noopener noreferrer" class="btn-outline">
					Download PDF
				</a>
			</div>
		</section>
	</div>
</BaseLayout>

<style>
	.links {
		margin: 0;
		padding: 0;
		list-style: none;
		max-width: 720px;
	}

	.link-row {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 8px 28px;
		padding: 24px 0;
		border-top: 1px solid var(--border-faint);
	}

	.link-row:last-child {
		border-bottom: 1px solid var(--border-faint);
	}

	.link-label {
		flex: 0 0 110px;
		font-size: 13px;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--cyan);
	}

	.link-value {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		font-size: 16.5px;
		color: var(--text);
		text-decoration: none;
		overflow-wrap: anywhere;
	}

	.link-value:hover {
		text-decoration: underline;
		text-underline-offset: 4px;
	}

	.link-arrow {
		font-size: 12px;
		color: var(--faint);
	}

	.cv-section {
		margin-top: 88px;
		padding-top: 56px;
		border-top: 1px solid var(--border-faint);
	}

	.cv-heading {
		font-size: clamp(24px, 2.6vw, 30px);
	}

	.cv-line {
		margin: 18px 0 32px;
		font-size: 16.5px;
		line-height: 1.7;
		color: var(--muted);
	}

	@media (max-width: 560px) {
		.link-label {
			flex-basis: 100%;
		}

		.cv-section {
			margin-top: 64px;
			padding-top: 44px;
		}
	}
</style>
