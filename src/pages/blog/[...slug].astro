---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import siteConfig from '../../config/site';

export async function getStaticPaths() {
	/*
	 * Drafts build in development so they can be previewed at their real
	 * URL, and are filtered out of production entirely. Filtering at the
	 * route means a draft has no page to find, not merely no link to it.
	 */
	const posts = await getCollection('blog', ({ data }) => import.meta.env.DEV || !data.draft);

	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, pubDate, tags, ogImage, readingTime, series } = post.data;

const published = pubDate.toLocaleDateString('en-AU', {
	day: 'numeric',
	month: 'long',
	year: 'numeric',
});
const isoDate = pubDate.toISOString().slice(0, 10);
---

<BaseLayout
	title={`${title}, ${siteConfig.author.name}`}
	description={description}
	ogImage={ogImage}
	ogImageAlt={title}
	ogType="article"
	publishedTime={pubDate}
>
	<div class="page">
		<article class="post">
			<header class="post-head">
				{series && <p class="post-series">{series}</p>}
				<h1 class="post-title">{title}</h1>
				<p class="post-meta">
					<time datetime={isoDate}>{published}</time>
					{readingTime && <span class="post-dot" aria-hidden="true">·</span>}
					{readingTime && <span>{readingTime}</span>}
				</p>
			</header>

			<div class="prose">
				<Content />
			</div>

			{
				tags.length > 0 && (
					<footer class="post-foot">
						<h2 class="post-foot-label">Tags</h2>
						<ul class="post-tags">
							{tags.map((tag) => (
								<li class="post-tag">{tag}</li>
							))}
						</ul>
					</footer>
				)
			}

			<p class="post-back">
				<a href="/blog/">Back to all posts</a>
			</p>
		</article>
	</div>
</BaseLayout>

<script is:inline defer src="/scripts/post-media.js"></script>

<style>
	/*
	 * The post is the one page on this site that leaves the left axis.
	 * A long read is a different object from a list of projects: there
	 * is no navigation or index running down one side to anchor it, so
	 * a 940px column pinned to the left of a 1072px page reads as a
	 * layout fault rather than a decision.
	 *
	 * Inside the centred block nothing else is centred. Text stays at
	 * 720px, about 70 characters in this face, and the heading, the
	 * body and the footer all share one left axis. Only media fills the
	 * 940px band, so a figure breaks out by 110px on each side instead
	 * of hanging off one edge.
	 */
	.post {
		max-width: 940px;
		margin-inline: auto;
	}

	.post-head {
		max-width: 720px;
		margin: 0 auto 48px;
	}

	.post-series {
		margin: 0 0 16px;
		font-size: 13px;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--cyan);
	}

	.post-title {
		margin: 0;
		font-size: clamp(30px, 3.8vw, 42px);
		font-weight: 700;
		line-height: 1.1;
		letter-spacing: -0.035em;
		text-wrap: balance;
		color: var(--text);
	}

	.post-meta {
		display: flex;
		align-items: center;
		gap: 10px;
		margin: 20px 0 0;
		font-size: 14px;
		color: var(--faint);
	}

	.post-dot {
		color: var(--border-subtle);
	}

	/* Long-form body copy. */

	/*
	 * The prose container is the media band, 940px wide. Text is held
	 * back to 720px by the rule below, about 68 characters. The split
	 * is the point: a 1200px terminal recording rendered inside a text
	 * measure comes out at 60 percent and its type stops being
	 * readable, so figures get the whole band and body copy keeps its
	 * line length.
	 */
	.prose {
		max-width: 940px;
		font-size: 17px;
		line-height: 1.75;
		color: var(--muted);
	}

	.prose :global(p),
	.prose :global(h2),
	.prose :global(h3),
	.prose :global(ul),
	.prose :global(ol),
	.prose :global(pre),
	.prose :global(hr),
	.prose :global(blockquote) {
		max-width: 720px;
	}

	/*
	 * Justified, with hyphenation on. Justified setting in a monospace
	 * face is the hard case: every space has the same advance width, so
	 * the browser can only pad lines by whole spaces, and without
	 * hyphenation those gaps open into rivers. Hyphens let a line break
	 * mid-word and keep the padding small. `text-wrap: pretty` goes,
	 * because it tunes a ragged edge and there is no longer one.
	 */
	.prose :global(p) {
		margin: 0 0 24px;
		text-align: justify;
		hyphens: auto;
	}

	.prose :global(h2) {
		margin: 56px 0 20px;
		font-size: 25px;
		font-weight: 600;
		line-height: 1.25;
		letter-spacing: -0.02em;
		text-wrap: balance;
		color: var(--text);
	}

	.prose :global(h3) {
		margin: 40px 0 16px;
		font-size: 19px;
		font-weight: 600;
		color: var(--text);
	}

	.prose :global(strong) {
		font-weight: 600;
		color: var(--text);
	}

	.prose :global(a) {
		color: var(--cyan);
		text-decoration: underline;
		text-underline-offset: 4px;
		text-decoration-thickness: 1px;
		/*
		 * Target size, WCAG 2.2 criterion 2.5.8. A prose link renders
		 * about 19px tall, under the 24px minimum. These sit inline in a
		 * sentence, which the criterion exempts, but the rest of the
		 * site pads its small links to clear it anyway and an automated
		 * check cannot see the exemption. Vertical padding on an inline
		 * element does not affect line height, so nothing moves.
		 */
		padding-block: 6px;
	}

	.prose :global(a:hover) {
		text-decoration-thickness: 2px;
	}

	.prose :global(ul),
	.prose :global(ol) {
		margin: 0 0 24px;
		padding-left: 22px;
	}

	.prose :global(li) {
		margin: 0 0 8px;
		text-align: justify;
		hyphens: auto;
	}

	.prose :global(hr) {
		margin: 56px 0;
		border: 0;
		border-top: 1px solid var(--border-faint);
	}

	.prose :global(em) {
		color: var(--faint);
		font-style: normal;
	}

	/* Code. */

	/*
	 * 4px of side padding rather than 6. Inline code is usually
	 * followed straight by a comma or a full stop, and the padded
	 * background puts a visible gap between the word and the
	 * punctuation. 6px read as a space that is not in the source.
	 */
	.prose :global(code) {
		padding: 2px 4px;
		border-radius: 4px;
		background: var(--code-inline-bg);
		font-size: 0.88em;
		color: var(--text);
	}

	.prose :global(pre) {
		margin: 0 0 24px;
		padding: 20px 22px;
		overflow-x: auto;
		border: 1px solid var(--border-subtle);
		border-radius: 8px;
		background: var(--code-block-bg);
		font-size: 14.5px;
		line-height: 1.7;
		/*
		 * JetBrains Mono ligatures fuse a double hyphen into a long dash,
		 * which turns a shell flag into something nobody could type. Off
		 * for code, as it already is for the terminal on the home page.
		 */
		font-variant-ligatures: none;
		font-feature-settings:
			'liga' 0,
			'calt' 0;
	}

	.prose :global(pre code) {
		padding: 0;
		border-radius: 0;
		background: none;
		font-size: inherit;
	}

	/*
	 * Prism token colours, drawn from the site palette so code reads as
	 * part of this site rather than as a pasted screenshot, and so both
	 * themes work. Class based, which is the point: a style attribute
	 * would be dropped by the Content-Security-Policy.
	 */

	.prose :global(.token.comment),
	.prose :global(.token.prolog),
	.prose :global(.token.doctype),
	.prose :global(.token.cdata) {
		color: var(--faint);
	}

	.prose :global(.token.punctuation),
	.prose :global(.token.operator),
	.prose :global(.token.entity) {
		color: var(--muted);
	}

	.prose :global(.token.string),
	.prose :global(.token.char),
	.prose :global(.token.attr-value),
	.prose :global(.token.inserted) {
		color: var(--green-text);
	}

	.prose :global(.token.function),
	.prose :global(.token.keyword),
	.prose :global(.token.selector),
	.prose :global(.token.builtin),
	.prose :global(.token.class-name) {
		color: var(--cyan);
	}

	.prose :global(.token.number),
	.prose :global(.token.boolean),
	.prose :global(.token.constant),
	.prose :global(.token.symbol),
	.prose :global(.token.variable),
	.prose :global(.token.regex) {
		color: var(--amber-text);
	}

	.prose :global(.token.deleted),
	.prose :global(.token.important) {
		color: var(--red-text);
	}

	/*
	 * Figures. Adapted from the draft's suggested CSS to the site's
	 * tokens rather than its hardcoded hexes, so both themes work and
	 * the caption colour stays the one that passes contrast.
	 */

	.prose :global(.post-media) {
		margin: 48px 0;
	}

	/*
	 * The recording carries its own terminal window, with its own
	 * rounded corners and its own surround. A site border on top of
	 * that is a frame around a frame, so video keeps the radius and
	 * the surface but loses the border. The diagram is flat artwork
	 * with no chrome of its own, so it still needs one.
	 */
	.prose :global(.post-media video) {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 12px;
		background: var(--code-block-bg);
	}

	.prose :global(.post-media img) {
		display: block;
		width: 100%;
		height: auto;
		border: 1px solid var(--border-subtle);
		border-radius: 12px;
		background: var(--card);
	}

	.prose :global(.post-media figcaption) {
		margin-top: 12px;
		font-size: 13px;
		line-height: 1.6;
		text-align: center;
		color: var(--faint);
	}

	/*
	 * Centring the text column inside the band. This has to sit after
	 * the element rules above: each of those sets `margin` as a
	 * shorthand, which resets the inline margins, so the auto only
	 * survives if it comes last.
	 */
	.prose :global(p),
	.prose :global(h2),
	.prose :global(h3),
	.prose :global(ul),
	.prose :global(ol),
	.prose :global(pre),
	.prose :global(hr),
	.prose :global(blockquote) {
		margin-inline: auto;
	}

	/* Tags and the way back. */

	.post-foot {
		max-width: 720px;
		margin: 64px auto 0;
		padding: 28px 0 0;
		border-top: 1px solid var(--border-faint);
	}

	.post-foot-label {
		margin: 0 0 14px;
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--faint);
	}

	.post-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.post-tag {
		padding: 6px 12px;
		border: 1px solid var(--border-faint);
		border-radius: 999px;
		font-size: 13px;
		color: var(--muted);
	}

	.post-back {
		max-width: 720px;
		margin: 40px auto 0;
		font-size: 15px;
	}

	.post-back a {
		color: var(--cyan);
		text-decoration: none;
		padding-block: 6px;
		display: inline-block;
	}

	.post-back a:hover {
		text-decoration: underline;
		text-underline-offset: 4px;
	}

	/*
	 * Justification needs slack to hide. Below roughly 60 characters a
	 * line there are too few word spaces to absorb the padding, and in
	 * a monospace face the gaps open to two or three character widths,
	 * which is worse than a ragged edge. The column clears 60
	 * characters at about a 760px viewport, so that is where justified
	 * setting stops.
	 */
	@media (max-width: 760px) {
		.prose :global(p),
		.prose :global(li) {
			text-align: left;
		}
	}

	@media (max-width: 560px) {
		.prose {
			font-size: 16.5px;
		}

		.prose :global(h2) {
			margin-top: 44px;
			font-size: 22px;
		}

		.prose :global(pre) {
			padding: 16px;
			font-size: 13.5px;
		}

		/*
		 * Full bleed on phones. The band is only 335px inside the
		 * gutters and every pixel of a terminal recording counts at
		 * that size. Gutters are 20px at this breakpoint, so the
		 * negative margin matches exactly and nothing overflows.
		 */
		.prose :global(.post-media) {
			width: calc(100% + 40px);
			margin-inline: -20px;
		}

		.prose :global(.post-media video),
		.prose :global(.post-media img) {
			border-radius: 0;
			border-left: 0;
			border-right: 0;
		}

		.prose :global(.post-media figcaption) {
			padding-inline: 20px;
		}
	}
</style>
