---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

/*
 * Drafts are filtered in production and visible in development, matching
 * the post route exactly. If the two ever disagree, the listing links to
 * a page that does not exist.
 */
const posts = (await getCollection('blog', ({ data }) => import.meta.env.DEV || !data.draft)).sort(
	(a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);
---

<BaseLayout
	title="Blog, Lawal Alabe"
	description="Writeups on cloud security architecture, infrastructure as code, and Kubernetes platform hardening."
>
	<div class="page">
		<header class="page-head">
			<h1 class="page-title">Blog</h1>
		</header>

		{
			posts.length === 0 ? (
				<p class="empty">Posts appear here as projects complete.</p>
			) : (
				<ul class="post-list">
					{posts.map((post) => (
						<li class="post-item">
							<a class="post-link" href={`/blog/${post.id}/`}>
								<p class="post-item-meta">
									<time datetime={post.data.pubDate.toISOString().slice(0, 10)}>
										{post.data.pubDate.toLocaleDateString('en-AU', {
											day: 'numeric',
											month: 'long',
											year: 'numeric',
										})}
									</time>
									{post.data.readingTime && (
										<>
											<span aria-hidden="true">·</span>
											<span>{post.data.readingTime}</span>
										</>
									)}
									{import.meta.env.DEV && post.data.draft && (
										<span class="post-draft">Draft</span>
									)}
								</p>
								<h2 class="post-item-title">{post.data.title}</h2>
								<p class="post-item-desc">{post.data.description}</p>
							</a>
						</li>
					))}
				</ul>
			)
		}
	</div>
</BaseLayout>

<style>
	.empty {
		max-width: 620px;
		margin: 0;
		padding: 40px 0 0;
		border-top: 1px solid var(--border-faint);
		font-size: 17px;
		line-height: 1.75;
		text-wrap: pretty;
		color: var(--muted);
	}

	.post-list {
		margin: 0;
		padding: 0;
		list-style: none;
		max-width: 760px;
		border-top: 1px solid var(--border-faint);
	}

	.post-item {
		border-bottom: 1px solid var(--border-faint);
	}

	/*
	 * The whole row is the link, so the target is the full block rather
	 * than a line of text. Padding on the anchor rather than the item,
	 * so the hit area and the visible row are the same rectangle.
	 */
	.post-link {
		display: block;
		padding: 28px 0;
		text-decoration: none;
	}

	.post-item-meta {
		display: flex;
		align-items: center;
		gap: 10px;
		margin: 0 0 10px;
		font-size: 13.5px;
		color: var(--faint);
	}

	.post-draft {
		padding: 2px 8px;
		border: 1px solid var(--amber-border);
		border-radius: 999px;
		background: var(--amber-dim);
		font-size: 12px;
		color: var(--amber-text);
	}

	.post-item-title {
		margin: 0;
		max-width: 42ch;
		font-size: 22px;
		font-weight: 600;
		line-height: 1.3;
		letter-spacing: -0.02em;
		text-wrap: balance;
		color: var(--text);
		transition: color 0.15s ease;
	}

	.post-link:hover .post-item-title {
		color: var(--cyan);
	}

	.post-item-desc {
		margin: 10px 0 0;
		max-width: 68ch;
		font-size: 16px;
		line-height: 1.7;
		text-wrap: pretty;
		color: var(--muted);
	}

	@media (max-width: 560px) {
		.post-item-title {
			font-size: 19px;
		}

		.post-item-desc {
			font-size: 15px;
		}
	}
</style>
