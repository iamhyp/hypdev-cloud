---
import siteConfig from '../config/site';

interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, `https://${siteConfig.site.domain}`);
const currentPath = Astro.url.pathname;
const year = new Date().getFullYear();

const navLinks = [
	{ href: '/', label: 'Home' },
	{ href: '/projects/', label: 'Projects' },
	{ href: '/about/', label: 'About' },
	{ href: '/certifications/', label: 'Certifications' },
	{ href: '/blog/', label: 'Blog' },
];

function isActive(href: string) {
	if (href === '/') return currentPath === '/';
	return currentPath.startsWith(href);
}

const isContactPage = currentPath.startsWith('/contact');
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />

		<script is:inline>
			(function () {
				var theme;
				try {
					theme = localStorage.getItem('theme');
				} catch (e) {}
				if (theme !== 'light' && theme !== 'dark') {
					theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
				}
				document.documentElement.setAttribute('data-theme', theme);
			})();
		</script>

		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&family=JetBrains+Mono:wght@400;500&display=swap"
		/>

		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:site_name" content={siteConfig.site.name} />

		<meta name="twitter:card" content="summary" />
	</head>
	<body>
		<nav class="site-nav">
			<div class="nav-inner">
				<a href="/" class="logo" aria-label={`${siteConfig.site.domain}, home`}>
					<span class="logo-hyp">{siteConfig.site.domain.slice(0, 3)}</span
					><span class="logo-dev">{siteConfig.site.domain.slice(3, 6)}</span
					><span class="logo-cloud">{siteConfig.site.domain.slice(6)}</span>
				</a>

				<button
					type="button"
					class="nav-toggle"
					id="nav-toggle"
					aria-expanded="false"
					aria-controls="nav-menu"
					aria-label="Menu"
				>
					<span class="nav-toggle-bar"></span>
					<span class="nav-toggle-bar"></span>
					<span class="nav-toggle-bar"></span>
				</button>

				<div class="nav-menu" id="nav-menu" hidden>
					{
						navLinks.map((link) => (
							<a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
								{link.label}
							</a>
						))
					}
				</div>

				<button type="button" class="theme-toggle" id="theme-toggle" aria-label="Switch to light theme">
					<svg
						class="icon-sun"
						viewBox="0 0 24 24"
						width="16"
						height="16"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
					>
						<circle cx="12" cy="12" r="5"></circle>
						<line x1="12" y1="1" x2="12" y2="3"></line>
						<line x1="12" y1="21" x2="12" y2="23"></line>
						<line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
						<line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
						<line x1="1" y1="12" x2="3" y2="12"></line>
						<line x1="21" y1="12" x2="23" y2="12"></line>
						<line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
						<line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
					</svg>
					<svg
						class="icon-moon"
						viewBox="0 0 24 24"
						width="16"
						height="16"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
					>
						<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
					</svg>
				</button>

				<a
					href="/contact/"
					class="btn-contact"
					aria-current={isContactPage ? 'page' : undefined}
				>
					Contact
				</a>
			</div>
		</nav>

		<main>
			<slot />
		</main>

		<footer class="site-footer">
			<p class="footer-left">{siteConfig.site.domain}, {year}</p>
			<div class="footer-links">
				<a href="/cv/">CV</a>
				<a href={siteConfig.social.github} target="_blank" rel="noopener noreferrer">GitHub</a>
				<a href={siteConfig.social.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
				<a href={`mailto:${siteConfig.social.email}`}>Email</a>
			</div>
		</footer>

		<script is:inline src="/scripts/nav.js"></script>

		<style is:global>
			:root {
				--green: #1db86a;
				--amber: #e8a020;
				--red: #e05252;

				--font-sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
				--font-mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas,
					monospace;
			}

			/* Dark theme (default). Also applied at bare :root so the page
			   is never unstyled before the anti-flash script sets the
			   attribute. */
			:root,
			:root[data-theme='dark'] {
				--bg: #08090e;
				--bg-secondary: #0c0d14;
				--card: #101119;
				--card-hover: #13141f;
				--nav-bg: #0c0d14;
				--nav-shadow: none;
				--cyan: #00bcd4;
				--cyan-dim: rgba(0, 188, 212, 0.08);
				--cyan-border: rgba(0, 188, 212, 0.14);
				--text: #e8eaf0;
				--muted: #8892aa;
				--faint: #464f6a;
				--border-faint: rgba(255, 255, 255, 0.055);
				--border-subtle: rgba(255, 255, 255, 0.09);
				--nav-border: rgba(255, 255, 255, 0.055);

				--nav-link: #b6bfd0;
				--nav-link-weight: 500;
				--nav-link-active: #e8eaf0;
				--nav-active-underline: #00bcd4;
				--nav-contact-bg: #00bcd4;
				--nav-contact-text: #000000;
				--nav-contact-weight: 500;
				--nav-toggle-color: #b6bfd0;
				--nav-toggle-border: rgba(255, 255, 255, 0.09);
				--logo-hyp: #00bcd4;
				--logo-dev: #e8eaf0;
				--logo-cloud: #464f6a;
			}

			:root[data-theme='light'] {
				--bg: #fdfcfa;
				--bg-secondary: #f4f1ec;
				--card: #ffffff;
				--card-hover: #f8f6f2;
				--nav-bg: #fffefc;
				--nav-shadow: 0 1px 3px rgba(0, 0, 0, 0.05);
				--cyan: #00798c;
				--cyan-dim: rgba(0, 121, 140, 0.09);
				--cyan-border: rgba(0, 121, 140, 0.25);
				--text: #12141a;
				--muted: #454c5c;
				--faint: #6b7383;
				--border-faint: rgba(0, 0, 0, 0.09);
				--border-subtle: rgba(0, 0, 0, 0.14);
				--nav-border: rgba(0, 0, 0, 0.13);

				--nav-link: #000000;
				--nav-link-weight: 600;
				--nav-link-active: #000000;
				--nav-active-underline: #00606f;
				--nav-contact-bg: #00606f;
				--nav-contact-text: #ffffff;
				--nav-contact-weight: 600;
				--nav-toggle-color: #000000;
				--nav-toggle-border: rgba(0, 0, 0, 0.14);
				--logo-hyp: #00606f;
				--logo-dev: #12141a;
				--logo-cloud: #6b7383;
			}

			*,
			*::before,
			*::after {
				box-sizing: border-box;
			}

			html,
			body {
				height: 100%;
			}

			body {
				display: flex;
				flex-direction: column;
				min-height: 100vh;
				margin: 0;
				background: var(--bg);
				color: var(--text);
				font-family: var(--font-sans);
				font-weight: 400;
				-webkit-font-smoothing: antialiased;
			}

			main {
				flex: 1;
			}

			a {
				color: inherit;
			}

			:focus-visible {
				outline: 2px solid var(--cyan);
				outline-offset: 2px;
			}

			/* Site navigation */

			.site-nav {
				position: sticky;
				top: 0;
				z-index: 50;
				background: var(--nav-bg);
				border-bottom: 1px solid var(--nav-border);
				box-shadow: var(--nav-shadow);
			}

			.nav-inner {
				position: relative;
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 24px;
				max-width: 1200px;
				margin: 0 auto;
				padding: 16px 24px;
			}

			.logo {
				font-family: var(--font-mono);
				font-weight: 500;
				font-size: 1.05rem;
				text-decoration: none;
				white-space: nowrap;
			}

			.logo-hyp {
				color: var(--logo-hyp);
			}

			.logo-dev {
				color: var(--logo-dev);
			}

			.logo-cloud {
				color: var(--logo-cloud);
			}

			.nav-toggle {
				display: none;
				flex-direction: column;
				justify-content: center;
				gap: 5px;
				width: 36px;
				height: 36px;
				padding: 0;
				background: none;
				border: 1px solid var(--border-subtle);
				border-radius: 6px;
				cursor: pointer;
			}

			.nav-toggle-bar {
				display: block;
				width: 16px;
				height: 2px;
				margin: 0 auto;
				background: var(--text);
			}

			.nav-menu {
				display: none;
				flex-direction: column;
				gap: 2px;
			}

			.nav-menu:not([hidden]) {
				display: flex;
			}

			.nav-menu a {
				position: relative;
				padding: 10px 12px;
				border-radius: 6px;
				text-decoration: none;
				font-size: 12.5px;
				font-weight: var(--nav-link-weight);
				color: var(--nav-link);
			}

			.nav-menu a[aria-current='page'] {
				font-weight: 600;
				color: var(--nav-link-active);
			}

			.nav-menu a[aria-current='page']::after {
				content: '';
				position: absolute;
				left: 12px;
				right: 12px;
				bottom: 6px;
				height: 2px;
				background: var(--nav-active-underline);
			}

			.theme-toggle {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				flex-shrink: 0;
				width: 36px;
				height: 36px;
				padding: 0;
				background: none;
				border: 1px solid var(--nav-toggle-border);
				border-radius: 6px;
				color: var(--nav-toggle-color);
				cursor: pointer;
			}

			.theme-toggle .icon-moon {
				display: none;
			}

			:root[data-theme='light'] .theme-toggle .icon-sun {
				display: none;
			}

			:root[data-theme='light'] .theme-toggle .icon-moon {
				display: inline-flex;
			}

			.btn-contact {
				flex-shrink: 0;
				padding: 8px 18px;
				background: var(--nav-contact-bg);
				color: var(--nav-contact-text);
				font-weight: var(--nav-contact-weight);
				font-size: 12.5px;
				text-decoration: none;
				border-radius: 6px;
			}

			@media (max-width: 859px) {
				.nav-toggle {
					display: inline-flex;
				}

				.nav-menu {
					position: absolute;
					top: 100%;
					left: 0;
					right: 0;
					padding: 8px;
					background: var(--card);
					border-bottom: 1px solid var(--border-faint);
				}
			}

			@media (min-width: 860px) {
				.nav-toggle {
					display: none;
				}

				.nav-menu[hidden] {
					display: flex;
				}

				.nav-menu {
					flex-direction: row;
					gap: 4px;
				}
			}

			/* Footer */

			.site-footer {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				justify-content: space-between;
				gap: 12px;
				max-width: 1200px;
				margin: 0 auto;
				width: 100%;
				padding: 24px;
				border-top: 1px solid var(--border-faint);
			}

			.footer-left {
				margin: 0;
				font-family: var(--font-mono);
				font-size: 0.85rem;
				color: var(--muted);
			}

			.footer-links {
				display: flex;
				gap: 20px;
			}

			.footer-links a {
				font-size: 0.9rem;
				color: var(--muted);
				text-decoration: none;
			}

			.footer-links a:hover {
				color: var(--text);
			}

			@media (prefers-reduced-motion: reduce) {
				*,
				*::before,
				*::after {
					animation-duration: 0.01ms !important;
					animation-iteration-count: 1 !important;
					transition-duration: 0.01ms !important;
					scroll-behavior: auto !important;
				}
			}
		</style>
	</body>
</html>
