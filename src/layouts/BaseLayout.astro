---
import siteConfig from '../config/site';

interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, `https://${siteConfig.site.domain}`);
// Social cards need an absolute URL; a relative path renders as a blank
// grey box in Slack, LinkedIn and iMessage.
const ogImageURL = new URL('/images/og.png', `https://${siteConfig.site.domain}`);
const currentPath = Astro.url.pathname;
const year = new Date().getFullYear();

const navLinks = [
	{ href: '/', label: 'Home' },
	{ href: '/projects/', label: 'Projects' },
	{ href: '/about/', label: 'About' },
	{ href: '/certifications/', label: 'Certifications' },
	{ href: '/blog/', label: 'Blog' },
	// The CV is a button in the bar above 859px and a menu row below it,
	// where the bar has no space for a third control. One entry, two
	// placements, so the two can never list different destinations.
	{ href: '/cv/', label: 'CV', menuOnly: true },
];

function isActive(href: string) {
	if (href === '/') return currentPath === '/';
	return currentPath.startsWith(href);
}

const isContactPage = currentPath.startsWith('/contact');
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />

		<script is:inline>
			(function () {
				var theme;
				try {
					theme = localStorage.getItem('theme');
				} catch (e) {}
				if (theme !== 'light' && theme !== 'dark') {
					theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
				}
				document.documentElement.setAttribute('data-theme', theme);
			})();
		</script>

		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&display=swap"
		/>

		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:site_name" content={siteConfig.site.name} />
		<meta property="og:locale" content="en_AU" />
		<meta property="og:image" content={ogImageURL} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta
			property="og:image:alt"
			content={`${siteConfig.author.name}, ${siteConfig.author.role}, ${siteConfig.site.domain}`}
		/>

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageURL} />
	</head>
	<body>
		<a href="#main" class="skip-link">Skip to content</a>

		<nav class="site-nav">
			<div class="nav-inner">
				<a href="/" class="logo" aria-label={`${siteConfig.site.domain}, home`}>
					<span class="logo-hyp">{siteConfig.site.domain.slice(0, 3)}</span
					><span class="logo-dev">{siteConfig.site.domain.slice(3, 6)}</span
					><span class="logo-cloud">{siteConfig.site.domain.slice(6)}</span>
				</a>

				<button
					type="button"
					class="nav-toggle"
					id="nav-toggle"
					aria-expanded="false"
					aria-controls="nav-menu"
					aria-label="Menu"
				>
					<span class="nav-toggle-bar"></span>
					<span class="nav-toggle-bar"></span>
					<span class="nav-toggle-bar"></span>
				</button>

				<div class="nav-menu" id="nav-menu" hidden>
					{
						navLinks.map((link) => (
							<a
								href={link.href}
								data-menu-only={link.menuOnly ? '' : undefined}
								aria-current={isActive(link.href) ? 'page' : undefined}
							>
								{link.label}
							</a>
						))
					}
				</div>

				<div class="nav-social">
					<a
						href={siteConfig.social.github}
						target="_blank"
						rel="noopener noreferrer"
						class="icon-link"
						aria-label="GitHub profile, opens in a new tab"
						title="GitHub"
					>
						<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
						<path
							d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
						></path>
					</svg>
					</a>
					<a
						href={siteConfig.social.linkedin}
						target="_blank"
						rel="noopener noreferrer"
						class="icon-link"
						aria-label="LinkedIn profile, opens in a new tab"
						title="LinkedIn"
					>
						<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
						<path
							d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.125 2.062 2.062 0 0 1 0 4.125zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
						></path>
					</svg>
					</a>
				</div>

				<button type="button" class="theme-toggle" id="theme-toggle" aria-label="Switch to light theme">
					<svg
						class="icon-sun"
						viewBox="0 0 24 24"
						width="16"
						height="16"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
					>
						<circle cx="12" cy="12" r="5"></circle>
						<line x1="12" y1="1" x2="12" y2="3"></line>
						<line x1="12" y1="21" x2="12" y2="23"></line>
						<line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
						<line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
						<line x1="1" y1="12" x2="3" y2="12"></line>
						<line x1="21" y1="12" x2="23" y2="12"></line>
						<line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
						<line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
					</svg>
					<svg
						class="icon-moon"
						viewBox="0 0 24 24"
						width="16"
						height="16"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
					>
						<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
					</svg>
				</button>

				<a
					href="/cv/"
					class="btn-cv"
					aria-current={currentPath.startsWith('/cv') ? 'page' : undefined}
				>
					CV
				</a>

				<a
					href="/contact/"
					class="btn-contact"
					aria-current={isContactPage ? 'page' : undefined}
				>
					Contact
				</a>
			</div>
		</nav>

		<main id="main" tabindex="-1">
			<slot />
		</main>

		<footer class="site-footer">
			<p class="footer-left">{siteConfig.site.domain}, {year}</p>
			<div class="footer-links">
				<a href="/cv/" class="icon-link" aria-label="Curriculum vitae" title="CV">
					<svg
						viewBox="0 0 24 24"
						width="20"
						height="20"
						fill="none"
						stroke="currentColor"
						stroke-width="1.7"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
					>
						<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
						<polyline points="14 2 14 8 20 8"></polyline>
						<line x1="8" y1="13" x2="14" y2="13"></line>
						<line x1="8" y1="17" x2="16" y2="17"></line>
					</svg>
				</a>

				<a
					href={siteConfig.social.github}
					target="_blank"
					rel="noopener noreferrer"
					class="icon-link"
					aria-label="GitHub profile, opens in a new tab"
					title="GitHub"
				>
					<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
						<path
							d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
						></path>
					</svg>
				</a>

				<a
					href={siteConfig.social.linkedin}
					target="_blank"
					rel="noopener noreferrer"
					class="icon-link"
					aria-label="LinkedIn profile, opens in a new tab"
					title="LinkedIn"
				>
					<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
						<path
							d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.125 2.062 2.062 0 0 1 0 4.125zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
						></path>
					</svg>
				</a>

				<a
					href={`mailto:${siteConfig.social.email}`}
					class="icon-link"
					aria-label={`Email ${siteConfig.social.email}`}
					title="Email"
				>
					<svg
						viewBox="0 0 24 24"
						width="20"
						height="20"
						fill="none"
						stroke="currentColor"
						stroke-width="1.7"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
					>
						<rect x="2" y="4" width="20" height="16" rx="2"></rect>
						<path d="m22 6-10 7L2 6"></path>
					</svg>
				</a>
			</div>
		</footer>

		<script is:inline src="/scripts/nav.js"></script>

		<style is:global>
			:root {
				--green: #1db86a;
				--amber: #e8a020;
				--red: #e05252;

				--font-mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas,
					monospace;
			}

			/* Dark theme (default). Also applied at bare :root so the page
			   is never unstyled before the anti-flash script sets the
			   attribute. */
			:root,
			:root[data-theme='dark'] {
				/*
				 * Dark is designed here, not mirrored from light. Three
				 * things make an inverted palette fail even when its
				 * contrast ratios match:
				 *
				 * 1. Halation. Light text on near-black bleeds outward
				 *    optically; dark text on white does not. Text at
				 *    17.9:1 does not read as crisp, it reads as glowing.
				 *    --text is now 13.5:1, deliberately lower.
				 * 2. Optical weight. The same glyph looks thinner on
				 *    dark, so --body-weight steps up here and only here.
				 * 3. Elevation. Light gets depth from shadow, which does
				 *    not work on dark. Dark gets it from surfaces, so
				 *    --card is a genuinely lighter plane rather than the
				 *    1.04:1 nudge it used to be.
				 */
				--bg: #0c0e13;
				--bg-secondary: #101319;
				--card: #151822;
				--card-hover: #1b1f2b;
				--body-weight: 500;
				--smoothing: auto;
				--nav-bg: rgba(12, 14, 19, 0.74);
				--nav-active-bg: rgba(255, 255, 255, 0.075);
				--nav-shadow: none;
				--cyan: #00bcd4;
				--cyan-dim: rgba(0, 188, 212, 0.08);
				--cyan-border: rgba(0, 188, 212, 0.2);
				--amber-text: #e8a020;
				--amber-dim: rgba(232, 160, 32, 0.1);
				--amber-border: rgba(232, 160, 32, 0.3);
				--text: #d2d8e4;
				--muted: #98a3b8;
				--faint: #7f8aa3;
				--border-faint: rgba(255, 255, 255, 0.1);
				--border-subtle: rgba(255, 255, 255, 0.16);
				--nav-border: rgba(255, 255, 255, 0.085);
				--grid-line: rgba(255, 255, 255, 0.085);
				--hero-glow: rgba(0, 188, 212, 0.055);

				--nav-link: #b3bccd;
				--nav-link-weight: 500;
				--nav-link-active: #e4e9f2;
				--nav-active-underline: #00bcd4;
				--nav-contact-bg: #00bcd4;
				--nav-contact-text: #000000;
				--nav-contact-weight: 500;
				--nav-toggle-color: #b6bfd0;
				--nav-toggle-border: rgba(255, 255, 255, 0.09);
				--logo-hyp: #00bcd4;
				--logo-dev: #e4e9f2;
				--logo-cloud: #8b95ad;
			}

			:root[data-theme='light'] {
				--bg: #fdfcfa;
				--bg-secondary: #f4f1ec;
				--card: #ffffff;
				--card-hover: #f8f6f2;
				--nav-bg: rgba(253, 252, 250, 0.8);
				--nav-active-bg: rgba(0, 0, 0, 0.055);
				--body-weight: 400;
				--smoothing: antialiased;
				--nav-shadow: 0 1px 3px rgba(0, 0, 0, 0.05);
				--cyan: #00798c;
				--cyan-dim: rgba(0, 121, 140, 0.09);
				--cyan-border: rgba(0, 121, 140, 0.25);
				--amber-text: #8a5a00;
				--amber-dim: rgba(138, 90, 0, 0.08);
				--amber-border: rgba(138, 90, 0, 0.3);
				--text: #12141a;
				--muted: #454c5c;
				--faint: #5c6474;
				--border-faint: rgba(0, 0, 0, 0.09);
				--border-subtle: rgba(0, 0, 0, 0.14);
				--nav-border: rgba(0, 0, 0, 0.13);
				--grid-line: rgba(0, 0, 0, 0.07);
				--hero-glow: rgba(0, 121, 140, 0.05);

				--nav-link: #000000;
				--nav-link-weight: 600;
				--nav-link-active: #000000;
				--nav-active-underline: #00606f;
				--nav-contact-bg: #00606f;
				--nav-contact-text: #ffffff;
				--nav-contact-weight: 600;
				--nav-toggle-color: #000000;
				--nav-toggle-border: rgba(0, 0, 0, 0.14);
				--logo-hyp: #00606f;
				--logo-dev: #12141a;
				--logo-cloud: #5c6474;
			}

			*,
			*::before,
			*::after {
				box-sizing: border-box;
			}

			html,
			body {
				height: 100%;
			}

			body {
				display: flex;
				flex-direction: column;
				min-height: 100vh;
				margin: 0;
				background: var(--bg);
				color: var(--text);
				font-family: var(--font-mono);
				font-weight: var(--body-weight);
				/*
				 * Grayscale smoothing thins glyphs. That suits dark text
				 * on a light page and works against light text on a dark
				 * one, where the strokes are already losing weight to the
				 * background, so it is set per theme rather than globally.
				 */
				-webkit-font-smoothing: var(--smoothing);
			}

			main {
				flex: 1;
			}

			a {
				color: inherit;
			}

			:focus-visible {
				outline: 2px solid var(--cyan);
				outline-offset: 2px;
			}

			/*
			 * Skip link. Off-screen until it takes focus, which makes it
			 * the first thing a keyboard visitor reaches and invisible to
			 * everyone else.
			 *
			 * Deliberately not transitioned. This element only becomes
			 * visible through a property change, so if transitions are
			 * slow, disabled, or not being driven at all, a transitioned
			 * skip link is a skip link that never appears. It was found
			 * stuck off-screen in exactly that state during development.
			 * The one control on the page that exists for people who
			 * cannot use a mouse does not get to depend on animation.
			 */
			.skip-link {
				position: absolute;
				top: -100px;
				left: 16px;
				z-index: 100;
				padding: 12px 20px;
				border-radius: 0 0 8px 8px;
				background: var(--cyan);
				color: var(--bg);
				font-size: 14px;
				font-weight: 600;
				text-decoration: none;
			}

			/*
			 * :focus, not :focus-visible. A skip link should appear for any
			 * focus at all, including focus moved by script or by a
			 * browser's own "jump to first link" affordance; focus-visible
			 * is a heuristic that can decline to match those.
			 */
			.skip-link:focus {
				top: 0;
			}

			main:focus {
				outline: none;
			}

			/*
			 * Page primitives, shared by every page. These lived in the
			 * home page's scoped styles until there was more than one
			 * page to share them with; duplicating a button across seven
			 * files is how a design system stops being one.
			 */

			.page {
				max-width: 1120px;
				margin: 0 auto;
				padding: 80px 24px 112px;
			}

			.page-head {
				margin: 0 0 56px;
			}

			.page-title {
				margin: 0;
				font-size: clamp(38px, 5.5vw, 62px);
				font-weight: 700;
				line-height: 1.05;
				letter-spacing: -0.04em;
				text-wrap: balance;
				color: var(--text);
			}

			.page-intro {
				margin: 20px 0 0;
				max-width: 640px;
				font-size: 17px;
				line-height: 1.75;
				text-wrap: pretty;
				color: var(--muted);
			}

			/* Section heading inside a page. */

			.section-head {
				margin: 0 0 48px;
			}

			.section-title {
				margin: 0;
				font-size: clamp(28px, 3.3vw, 40px);
				font-weight: 700;
				line-height: 1.15;
				letter-spacing: -0.035em;
				text-wrap: balance;
				color: var(--text);
			}

			.section-subtitle {
				margin: 16px 0 0;
				max-width: 620px;
				font-size: 16.5px;
				line-height: 1.7;
				text-wrap: pretty;
				color: var(--muted);
			}

			/* Buttons. */

			.btn-primary {
				display: inline-flex;
				align-items: center;
				padding: 16px 32px;
				background: var(--cyan);
				color: var(--bg);
				font-size: 16px;
				font-weight: 600;
				letter-spacing: -0.005em;
				text-decoration: none;
				border-radius: 999px;
				transition: filter 0.15s ease;
			}

			.btn-primary:hover {
				filter: brightness(1.08);
			}

			.btn-outline {
				display: inline-flex;
				align-items: center;
				padding: 16px 32px;
				border: 1px solid var(--border-subtle);
				color: var(--text);
				font-size: 16px;
				font-weight: 600;
				letter-spacing: -0.005em;
				text-decoration: none;
				border-radius: 999px;
				transition: border-color 0.15s ease;
			}

			.btn-outline:hover {
				border-color: var(--muted);
			}

			.button-row {
				display: flex;
				flex-wrap: wrap;
				gap: 14px;
			}

			/* Raised surface. Dark takes its depth from this, not shadow. */

			.card {
				background: var(--card);
				border: 1px solid var(--border-subtle);
				border-radius: 8px;
				transition:
					border-color 0.2s ease,
					background-color 0.2s ease;
			}

			/* An out-arrow marks a link that leaves the site. */

			.ext {
				display: inline-flex;
				align-items: center;
				gap: 6px;
				color: var(--cyan);
				text-decoration: none;
			}

			.ext:hover {
				text-decoration: underline;
				text-underline-offset: 4px;
			}

			/*
			 * Target size, WCAG 2.2 criterion 2.5.8. These links render
			 * 16 to 19px tall as text, under the 24px minimum, and none
			 * of them sit inline in a sentence so the inline exception
			 * does not apply.
			 *
			 * Padding rather than an absolutely positioned pseudo-element
			 * over the link. The pseudo-element grows the region that
			 * accepts a pointer, which is what the criterion actually
			 * measures, but it leaves getBoundingClientRect unchanged, so
			 * every automated checker still reports a failure and nobody
			 * auditing this site can see that it passes. Padding grows
			 * the box itself. These are all inline-level, so the vertical
			 * padding does not affect line height and the text does not
			 * move; inside the two flex rows it adds a few pixels of
			 * height, which touch wants anyway.
			 *
			 * .publication-link and .paper-link are here because they
			 * failed only above 768px. On a phone they wrap onto two
			 * lines and measure over 24px tall, so a mobile-only sweep
			 * reports them as passing. Target size is not a mobile
			 * problem; it is a pointer problem, and a mouse is a pointer.
			 */
			.ext,
			.logo,
			.hero-link,
			.link-value,
			.publication-link,
			.paper-link {
				padding-block: 6px;
			}

			.ext::after {
				content: '↗';
				font-size: 12px;
			}

			@media (max-width: 560px) {
				.page {
					padding: 56px 20px 80px;
				}

				.page-head {
					margin-bottom: 40px;
				}

				.btn-primary,
				.btn-outline {
					padding: 15px 22px;
					font-size: 15px;
				}
			}

			/* Site navigation */

			.site-nav {
				position: sticky;
				top: 0;
				z-index: 50;
				background: var(--nav-bg);
				-webkit-backdrop-filter: saturate(160%) blur(14px);
				backdrop-filter: saturate(160%) blur(14px);
				border-bottom: 1px solid var(--nav-border);
				box-shadow: var(--nav-shadow);
			}

			.nav-inner {
				position: relative;
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 28px;
				max-width: 1120px;
				margin: 0 auto;
				height: 76px;
				padding: 0 24px;
			}

			.logo {
				font-family: var(--font-mono);
				font-weight: 500;
				font-size: 1.375rem;
				letter-spacing: -0.02em;
				text-decoration: none;
				white-space: nowrap;
			}

			.logo-hyp {
				color: var(--logo-hyp);
			}

			.logo-dev {
				color: var(--logo-dev);
			}

			.logo-cloud {
				color: var(--logo-cloud);
			}

			.nav-toggle {
				display: none;
				flex-direction: column;
				justify-content: center;
				gap: 5px;
				width: 44px;
				height: 44px;
				padding: 0;
				background: none;
				border: 1px solid var(--border-subtle);
				border-radius: 6px;
				cursor: pointer;
			}

			.nav-toggle-bar {
				display: block;
				width: 16px;
				height: 2px;
				margin: 0 auto;
				background: var(--text);
			}

			.nav-menu {
				display: none;
				flex-direction: column;
				gap: 2px;
			}

			.nav-menu:not([hidden]) {
				display: flex;
			}

			.nav-menu a {
				position: relative;
				padding: 9px 16px;
				border-radius: 999px;
				text-decoration: none;
				font-size: 15.5px;
				letter-spacing: -0.01em;
				font-weight: var(--nav-link-weight);
				color: var(--nav-link);
				transition:
					color 0.15s ease,
					background-color 0.15s ease;
			}

			.nav-menu a:hover {
				color: var(--nav-link-active);
			}

			.nav-menu a[aria-current='page'] {
				font-weight: 600;
				color: var(--nav-link-active);
				background: var(--nav-active-bg);
			}

			.nav-menu a[aria-current='page']::before {
				content: '';
				position: absolute;
				left: 16px;
				top: 50%;
				width: 5px;
				height: 5px;
				margin-top: -2.5px;
				border-radius: 50%;
				background: var(--nav-active-underline);
			}

			/* The dot sits inside the pill, so the label shifts right to
			   make room rather than overlapping it. */
			.nav-menu a[aria-current='page'] {
				padding-left: 30px;
			}

			.theme-toggle {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				flex-shrink: 0;
				width: 44px;
				height: 44px;
				padding: 0;
				background: none;
				border: 1px solid var(--nav-toggle-border);
				border-radius: 6px;
				color: var(--nav-toggle-color);
				cursor: pointer;
			}

			.theme-toggle .icon-moon {
				display: none;
			}

			:root[data-theme='light'] .theme-toggle .icon-sun {
				display: none;
			}

			:root[data-theme='light'] .theme-toggle .icon-moon {
				display: inline-flex;
			}

			.nav-social {
				display: flex;
				gap: 2px;
				margin-left: auto;
			}

			/*
			 * The CV sits beside Contact rather than in the link list. It
			 * is the highest-intent page on the site for the audience this
			 * is built for, and the link list currently leads with two
			 * pages that are empty by design. Outline against Contact's
			 * fill: a pair of actions, with the primary one still obvious.
			 */
			.btn-cv {
				flex-shrink: 0;
				padding: 10px 20px;
				border: 1px solid var(--border-subtle);
				color: var(--text);
				font-weight: 500;
				font-size: 15px;
				letter-spacing: -0.01em;
				text-decoration: none;
				border-radius: 999px;
				transition:
					border-color 0.15s ease,
					background-color 0.15s ease;
			}

			.btn-cv:hover {
				border-color: var(--cyan);
				background: var(--cyan-dim);
			}

			.btn-cv[aria-current='page'] {
				border-color: var(--cyan);
			}

			.btn-contact {
				flex-shrink: 0;
				padding: 11px 24px;
				background: var(--nav-contact-bg);
				color: var(--nav-contact-text);
				font-weight: var(--nav-contact-weight);
				font-size: 15px;
				letter-spacing: -0.01em;
				text-decoration: none;
				border-radius: 999px;
			}

			/* The bar grew for desktop; below 560px the five controls no
			   longer fit at that scale, so the chrome steps back down
			   rather than pushing Contact off the edge. */
			@media (max-width: 900px) {
				.nav-social {
					display: none;
				}
			}

			@media (max-width: 560px) {
				.nav-inner {
					height: 64px;
					gap: 10px;
					padding: 0 16px;
				}

				.logo {
					font-size: 1.02rem;
				}

				/*
				 * The theme toggle used to shrink to 36px here. That is
				 * backwards: the target should grow when the pointer
				 * becomes a fingertip, not shrink. It stays 44px.
				 */

				.btn-contact {
					padding: 15px 16px;
					font-size: 13px;
				}
			}

			@media (min-width: 860px) {
				.nav-menu [data-menu-only] {
					display: none;
				}
			}

			@media (max-width: 859px) {
				/* Three controls plus the logo is too much at 375px, so the
				   CV button drops out here and appears in the menu instead. */
				.btn-cv {
					display: none;
				}

				.nav-toggle {
					display: inline-flex;
				}

				.nav-menu {
					position: absolute;
					top: 100%;
					left: 0;
					right: 0;
					padding: 12px;
					background: var(--card);
					border-bottom: 1px solid var(--border-faint);
				}
			}

			@media (min-width: 860px) {
				.nav-toggle {
					display: none;
				}

				.nav-menu[hidden] {
					display: flex;
				}

				.nav-menu {
					flex-direction: row;
					gap: 6px;
				}

				/* A bordered square icon button reads as dashboard chrome at
				   rest. On desktop, where hover is available, the border only
				   appears on interaction instead of sitting there permanently. */
				.theme-toggle {
					border-color: transparent;
					transition: border-color 0.15s ease;
				}

				.theme-toggle:hover,
				.theme-toggle:focus-visible {
					border-color: var(--nav-toggle-border);
				}
			}

			/* Footer */

			.site-footer {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				justify-content: space-between;
				gap: 12px;
				max-width: 1120px;
				margin: 0 auto;
				width: 100%;
				padding: 32px 24px;
				border-top: 1px solid var(--border-faint);
			}

			.footer-left {
				margin: 0;
				font-family: var(--font-mono);
				font-size: 14px;
				color: var(--muted);
			}

			.footer-links {
				display: flex;
				gap: 6px;
			}

			/*
			 * Circular icon buttons rather than four words. Each keeps an
			 * aria-label naming the destination and a title for the
			 * tooltip, so nothing is lost to a screen reader or to a
			 * visitor who does not recognise a glyph.
			 */
			.icon-link {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				width: 44px;
				height: 44px;
				border-radius: 50%;
				color: var(--muted);
				text-decoration: none;
				transition:
					color 0.15s ease,
					background-color 0.15s ease;
			}

			.icon-link:hover {
				color: var(--text);
				background: var(--border-faint);
			}

			.icon-link svg {
				display: block;
			}

			@media (prefers-reduced-motion: reduce) {
				*,
				*::before,
				*::after {
					animation-duration: 0.01ms !important;
					animation-iteration-count: 1 !important;
					transition-duration: 0.01ms !important;
					scroll-behavior: auto !important;
				}
			}
		</style>
	</body>
</html>
